# Copy to .env (or /etc/demodude/env on the server). Never commit a real key.

# Required for the AI guide. The SDK reads this itself. Without it the service
# still starts and the panel shows "Demo AI is not configured".
ANTHROPIC_API_KEY=

# Bind address and port.
HOST=127.0.0.1
PORT=8900

# Folder holding one sub-folder per app bundle (see docs/protocol.md).
APPS_DIR=./apps

# Folder for the SQLite file (sessions.db).
DATA_DIR=./data

# Unlocks GET /api/admin/stats?token=... . Leave empty to disable the endpoint.
ADMIN_TOKEN=

# URL prefix when the reverse proxy mounts the service under a sub-path,
# e.g. /demo -> panel at /demo/<app>, bundle at /demo/apps/<app>/, API at /demo/api/.
# Leave empty when the service is served from the root (panel at /demo/<app>).
PUBLIC_BASE_PATH=
